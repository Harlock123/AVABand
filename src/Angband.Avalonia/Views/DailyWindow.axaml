<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        x:Class="Angband.Avalonia.Views.DailyWindow"
        x:DataType="vm:DailyViewModel"
        Title="The daily dungeon"
        Width="900" Height="560"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <!-- Today's character and the way in, then every try so far. -->
    <Border DockPanel.Dock="Top" Background="#1a1512" BorderBrush="#4a3a2a" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,14">
      <DockPanel>
        <Button x:Name="PlayButton" DockPanel.Dock="Right" Content="Play today's dungeon" Classes="accent" Command="{Binding PlayCommand}"
                VerticalAlignment="Center" Padding="16,8" />
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Today, StringFormat='The daily dungeon · {0}'}" FontFamily="{StaticResource TitleFont}" FontSize="22" Foreground="#e2d3ae" />
          <TextBlock Text="{Binding Character}" FontSize="16" Foreground="#ece3d6" />
          <TextBlock Text="{Binding Stats}" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="#b8a898" />
          <TextBlock Text="The same dungeon and character for everyone who plays it today; a new one tomorrow (UTC)."
                     FontSize="12" Foreground="#a0907e" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
    </Border>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Button DockPanel.Dock="Right" Content="Close" Click="OnClose" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Watch this try" Command="{Binding WatchCommand}" />
      <Button DockPanel.Dock="Right" Content="Save replay as…" Command="{Binding SaveReplayCommand}" Margin="0,0,8,0" />
      <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy result" Command="{Binding CopyResultCommand}" Margin="0,0,8,0" />
      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" Spacing="2">
        <TextBlock Text="{Binding ShareNote}" FontSize="12" Foreground="#8fe0a0" TextWrapping="Wrap" IsVisible="{Binding ShareNote.Length}" />
        <TextBlock Text="{Binding ReplayNote}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="100,60,*,140,90,*" Margin="10,0,10,6">
      <TextBlock Grid.Column="0" Text="Day" FontWeight="SemiBold" Foreground="#8ab4f8" />
      <TextBlock Grid.Column="1" Text="Try" FontWeight="SemiBold" Foreground="#8ab4f8" />
      <TextBlock Grid.Column="2" Text="Character" FontWeight="SemiBold" Foreground="#8ab4f8" />
      <TextBlock Grid.Column="3" Text="Reached" FontWeight="SemiBold" Foreground="#8ab4f8" />
      <TextBlock Grid.Column="4" Text="Points" FontWeight="SemiBold" Foreground="#8ab4f8" />
      <TextBlock Grid.Column="5" Text="Fate" FontWeight="SemiBold" Foreground="#8ab4f8" />
    </Grid>
    <Panel>
      <TextBlock Text="No tries yet. Every day brings a new dungeon." IsVisible="{Binding IsEmpty}" Opacity="0.7"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="Tries" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DailyRow">
            <Grid ColumnDefinitions="100,60,*,140,90,*">
              <TextBlock Grid.Column="0" Text="{Binding Day}" />
              <TextBlock Grid.Column="1" Text="{Binding Attempt}" Opacity="0.8" />
              <TextBlock Grid.Column="2" Text="{Binding Who}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Reached}" />
              <TextBlock Grid.Column="4" Text="{Binding Points}" />
              <TextBlock Grid.Column="5" Text="{Binding Fate}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</Window>
