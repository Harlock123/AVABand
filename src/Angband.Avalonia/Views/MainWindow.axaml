<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        xmlns:v="using:Angband.Avalonia.Views"
        xmlns:controls="using:Angband.Avalonia.Controls"
        x:Class="Angband.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AVABand"
        Width="1280" Height="800"
        Background="Black">
  <Window.Resources>
    <DataTemplate x:Key="ItemRowTemplate" x:DataType="vm:ItemRow">
      <Grid ColumnDefinitions="Auto,18,*,Auto" Margin="0,1" Background="Transparent" PointerPressed="OnItemRowPressed"
            AutomationProperties.Name="{Binding Name}">
        <TextBlock Grid.Column="0" MinWidth="22" Text="{Binding Letter, StringFormat={}{0})}" Foreground="#bbb"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,4,0" />
        <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="#eee" FontSize="12" TextWrapping="Wrap" />
        <TextBlock Grid.Column="3" Text="{Binding Weight}" Foreground="#888" FontSize="11" Margin="6,0,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ListRowTemplate" x:DataType="vm:ListRow">
      <Grid ColumnDefinitions="18,*,Auto" Margin="0,1">
        <TextBlock Grid.Column="0" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding TextBrush}" FontWeight="{Binding Weight}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="{Binding TextBrush}"
                   FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="10,0,0,0" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="Foreground" Value="#8ab4f8" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,10,0,2" />
    </Style>
  </Window.Styles>

  <Panel>
  <DockPanel>
    <LayoutTransformControl DockPanel.Dock="Top" LayoutTransform="{Binding InterfaceTransform}">
    <Menu>
      <MenuItem Header="_Game">
        <MenuItem Header="_New character..." Command="{Binding NewGameCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Quick start (same character)" Command="{Binding QuickStartCommand}" />
        <MenuItem x:Name="NewGameAsMenu" Header="Quick start _as" />
        <MenuItem Header="_Tutorial (learn the basics)" Command="{Binding StartTutorialCommand}" />
        <MenuItem Header="_Watch a replay..." Command="{Binding WatchReplayCommand}" />
        <MenuItem Header="Your _journey..." Command="{Binding ShowJourneyCommand}" />
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveGameCommand}" InputGesture="Ctrl+S" IsEnabled="{Binding CanSave}" />
        <MenuItem Header="_Load character..." Command="{Binding LoadGameCommand}" InputGesture="Ctrl+O" IsEnabled="{Binding CanSave}" />
        <Separator />
        <MenuItem Header="_Character sheet..." Command="{Binding ShowCharacterSheetCommand}" InputGesture="Shift+C" />
        <MenuItem Header="_High scores..." Command="{Binding ShowHighScoresCommand}" InputGesture="Ctrl+H" />
        <MenuItem Header="The _graveyard..." Command="{Binding ShowGraveyardCommand}" />
        <MenuItem Header="_Knowledge..." Command="{Binding ShowKnowledgeCommand}" InputGesture="Shift+OemTilde" />
        <MenuItem Header="_Repeat last command" Command="{Binding RepeatLastCommandCommand}" InputGesture="Ctrl+V" />
        <MenuItem Header="_Message history..." Command="{Binding ShowMessageHistoryCommand}" InputGesture="Ctrl+P" />
        <MenuItem Header="Level _feeling" Command="{Binding ShowFeelingCommand}" InputGesture="Ctrl+F" />
        <MenuItem Header="_Retire (after winning)" Command="{Binding RetireCommand}" InputGesture="Shift+Q" />
        <MenuItem Header="Shops pay _gold when you sell" Command="{Binding ToggleShopsPayGoldCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding ShopsPayGold, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="Save and _quit" Command="{Binding SaveAndQuitCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="E_xit" Click="OnExit" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Graphical tiles" Command="{Binding ToggleTilesCommand}" InputGesture="Ctrl+T"
                  ToggleType="CheckBox" IsChecked="{Binding UseTiles, Mode=OneWay}" IsEnabled="{Binding HasTilesets}" />
        <MenuItem Header="_Options..." Command="{Binding ShowOptionsCommand}" InputGesture="OemPlus" />
        <MenuItem Header="_Settings..." Click="OnOpenSettings" InputGesture="F10" />
        <MenuItem Header="_Mute sound" Command="{Binding ToggleMuteCommand}" InputGesture="Ctrl+M"
                  ToggleType="CheckBox" IsChecked="{Binding Muted, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="Monster list in the sidebar" Command="{Binding ToggleMonsterPanelCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding ShowMonsterPanel, Mode=OneWay}" />
        <MenuItem Header="Object list in the sidebar" Command="{Binding ToggleObjectPanelCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding ShowObjectPanel, Mode=OneWay}" />
        <MenuItem Header="Monster recall in the sidebar" Command="{Binding ToggleRecallPanelCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding ShowRecallPanel, Mode=OneWay}" />
        <MenuItem Header="Hotbar (Alt+1 to Alt+0)" Command="{Binding ToggleHotbarCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding ShowHotbar, Mode=OneWay}" />
        <Separator />
        <MenuItem Header="Level _map..." Command="{Binding ShowOverviewMapCommand}" InputGesture="Shift+M" />
        <MenuItem Header="_Center map" Command="{Binding CenterMapCommand}" InputGesture="Ctrl+L" />
        <Separator />
        <MenuItem Header="Zoom _in" Command="{Binding ZoomInCommand}" InputGesture="Ctrl+OemPlus" />
        <MenuItem Header="Zoom _out" Command="{Binding ZoomOutCommand}" InputGesture="Ctrl+OemMinus" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_Help topics..." Command="{Binding ShowHelpCommand}" />
        <MenuItem Header="Keyboard _commands..." Command="{Binding ShowKeyCommandsCommand}" InputGesture="F1" />
        <Separator />
        <MenuItem Header="What's _new..." Command="{Binding ShowWhatsNewCommand}" />
        <MenuItem Header="Check for _updates..." Command="{Binding CheckForUpdatesCommand}" />
      </MenuItem>
      <MenuItem Header="_Debug">
        <MenuItem Header="_Regenerate level" Command="{Binding RegenerateLevelCommand}" InputGesture="F5" />
        <MenuItem Header="Jump to _next level" Command="{Binding JumpNextLevelCommand}" InputGesture="F8" />
        <MenuItem Header="_Jump 5 levels deeper" Command="{Binding JumpDeeperCommand}" InputGesture="F6" />
        <MenuItem Header="Jump back to _town" Command="{Binding JumpToTownCommand}" InputGesture="F9" />
        <MenuItem Header="Show _whole map" Command="{Binding ToggleWholeMapCommand}" InputGesture="F7" />
        <MenuItem Header="_Cure all" Command="{Binding CureAllCommand}" />
        <Separator />
        <MenuItem Header="Character _marked by debug (not scored)" Command="{Binding ToggleDebugMarkCommand}"
                  ToggleType="CheckBox" IsChecked="{Binding DebugMarked, Mode=OneWay}" />
      </MenuItem>
    </Menu>
    </LayoutTransformControl>

    <LayoutTransformControl DockPanel.Dock="Top" LayoutTransform="{Binding InterfaceTransform}">
    <Border Background="#101010" Padding="8,4">
      <Panel>
        <StackPanel>
          <ItemsControl ItemsSource="{Binding EarlierMessages}" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MessageLine">
                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontFamily="{StaticResource MonoFont}"
                           TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding LastMessage}" Foreground="White" FontFamily="{StaticResource MonoFont}" />
        </StackPanel>
        <!-- Screen reader support: a live region, read out whenever it changes (it is not drawn). -->
        <TextBlock x:Name="LiveRegion" Text="{Binding Announcement}" AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="{Binding Announcement}" Width="1" Height="1" Opacity="0"
                   HorizontalAlignment="Left" ClipToBounds="True" IsHitTestVisible="False" />
      </Panel>
    </Border>
    </LayoutTransformControl>

    <LayoutTransformControl DockPanel.Dock="Bottom" LayoutTransform="{Binding InterfaceTransform}">
    <Border Background="#101010" Padding="8,4">
      <DockPanel>
        <!-- The count typed with '0', while it is typed and until a command uses it. -->
        <Border Name="CountBadge" DockPanel.Dock="Right" Background="#804000" CornerRadius="3" Padding="6,0"
                IsVisible="{Binding CountBadge, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding CountBadge}" Foreground="White" FontFamily="{StaticResource MonoFont}" />
        </Border>
        <ItemsControl x:Name="StatusBar" ItemsSource="{Binding StatusFields}" AutomationProperties.Name="{Binding StatusText}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Foreground="#C0C0C0" FontFamily="{StaticResource MonoFont}" Margin="0,0,12,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>
    </LayoutTransformControl>

    <!-- Inventory panel -->
    <LayoutTransformControl DockPanel.Dock="Right" LayoutTransform="{Binding InterfaceTransform}">
    <Border Width="340" Background="#0c0c0c" BorderBrush="#222" BorderThickness="1,0,0,0">
      <DockPanel>
      <!-- Monster recall (Angband's recall subwindow): the monster looked at, targeted or struck. -->
      <Border x:Name="RecallPanel" DockPanel.Dock="Bottom" IsVisible="{Binding HasRecallPanel}" MaxHeight="280"
              BorderBrush="#222" BorderThickness="0,1,0,0" Background="#0a0a10">
        <DockPanel Margin="10,6,10,8">
          <TextBlock DockPanel.Dock="Top" Classes="header" Text="Monster recall" />
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding RecallPanelText}" v:RichText.Runs="{Binding RecallPanelRuns}"
                                 TextWrapping="Wrap" FontSize="12" Foreground="#ccc" />
          </ScrollViewer>
        </DockPanel>
      </Border>
      <ScrollViewer>
        <StackPanel Margin="10" Spacing="4">
          <TextBlock Text="{Binding GoldText}" Foreground="Gold" FontWeight="SemiBold" />
          <TextBlock Text="{Binding BurdenText}" Foreground="#aaa" FontSize="12" TextWrapping="Wrap" />
          <!-- The monster health bar (Angband): the monster last targeted, looked at or struck. -->
          <StackPanel x:Name="HealthBar" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HealthVisible}" Margin="0,4,0,0">
            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="14">
              <Run Text="[" Foreground="White" /><Run Text="{Binding HealthStars}" Foreground="{Binding HealthBrush}" /><Run Text="{Binding HealthRest}" Foreground="White" /><Run Text="]" Foreground="White" />
            </TextBlock>
            <TextBlock Text="{Binding HealthName}" Foreground="#ccc" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="200" />
          </StackPanel>
          <TextBlock Classes="header" Text="Equipment" />
          <ItemsControl ItemsSource="{Binding EquipmentRows}" ItemTemplate="{StaticResource ItemRowTemplate}" />
          <TextBlock Classes="header" Text="Inventory" />
          <ItemsControl ItemsSource="{Binding PackRows}" ItemTemplate="{StaticResource ItemRowTemplate}" />
          <TextBlock Classes="header" Text="Quiver" />
          <ItemsControl ItemsSource="{Binding QuiverRows}" ItemTemplate="{StaticResource ItemRowTemplate}" />
          <TextBlock Classes="header" Text="On the floor" IsVisible="{Binding HasFloorItems}" />
          <ItemsControl ItemsSource="{Binding FloorRows}" ItemTemplate="{StaticResource ItemRowTemplate}" />
          <TextBlock Classes="header" Text="Monsters" IsVisible="{Binding ShowMonsterPanel}" />
          <ItemsControl x:Name="MonsterPanel" ItemsSource="{Binding MonsterPanelRows}" ItemTemplate="{StaticResource ListRowTemplate}"
                        IsVisible="{Binding ShowMonsterPanel}" />
          <TextBlock Classes="header" Text="Objects" IsVisible="{Binding ShowObjectPanel}" />
          <ItemsControl x:Name="ObjectPanel" ItemsSource="{Binding ObjectPanelRows}" ItemTemplate="{StaticResource ListRowTemplate}"
                        IsVisible="{Binding ShowObjectPanel}" />
          <TextBlock Margin="0,12,0,0" Foreground="#777" FontSize="11" TextWrapping="Wrap"
                     Text="? help  F1 all commands  w wield  t take off  q quaff  r read  E eat  d drop  v throw  g pick up  F refuel  I inspect  i/e item menu  { } inscribe  ^D ignore  ^K clear junk  K show ignored  f fire  R rest  m cast  G study  B browse  a aim  Z use staff  z zap  A activate  o/c open/close  T tunnel  D disarm  s steal (rogues)  x look  * target  [ monsters  ] objects  ~ knowledge  = options  C character  Q retire" />
        </StackPanel>
      </ScrollViewer>
      </DockPanel>
    </Border>
    </LayoutTransformControl>

    <!-- The hotbar (AVABand's own): spells and items on Alt+1..Alt+0; click to use, right-click to change. -->
    <LayoutTransformControl DockPanel.Dock="Bottom" LayoutTransform="{Binding InterfaceTransform}" IsVisible="{Binding ShowHotbar}">
      <Border Background="#0a0a0a" BorderBrush="#222" BorderThickness="0,1,0,0" Padding="6,4">
        <ItemsControl x:Name="Hotbar" ItemsSource="{Binding HotbarSlots}" HorizontalAlignment="Center" DragDrop.AllowDrop="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HotbarSlotRow">
              <Border Width="84" Height="42" Margin="2" CornerRadius="3" Background="#15161c" BorderBrush="{Binding Outline}" BorderThickness="1"
                      AutomationProperties.Name="{Binding Tip}"
                      Cursor="Hand" ToolTip.Tip="{Binding Tip}" Opacity="{Binding Opacity}" PointerPressed="OnHotbarPressed">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="*,*" Margin="4,2">
                  <TextBlock Grid.RowSpan="2" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" FontFamily="{StaticResource MonoFont}"
                             FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="#ddd" FontSize="11" TextTrimming="CharacterEllipsis" />
                  <DockPanel Grid.Column="1" Grid.Row="1">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Key}" Foreground="#667" FontSize="10" FontFamily="{StaticResource MonoFont}" />
                    <TextBlock Text="{Binding Detail}" Foreground="#889" FontSize="10" />
                  </DockPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </LayoutTransformControl>
    <Panel>
    <controls:MapView x:Name="Map"
                      Source="{Binding Map}"
                      Revision="{Binding Revision}"
                      CellFontSize="{Binding MapFontSize}"
                      UseTiles="{Binding UseTiles}"
                      Tileset="{Binding SelectedTileset}"
                      TileScale="{Binding TileScale}"
                      CenterPlayer="{Binding CenterPlayer}"
                      AutomationProperties.Name="{Binding MapSummary}"
                      RecentreCount="{Binding RecentreCount}"
                      Effects="{Binding Effects}"
                      ClipToBounds="True" />

      <!-- Everything over the map scales with the interface size; the map itself has its own zoom. -->
      <LayoutTransformControl LayoutTransform="{Binding InterfaceTransform}">
      <Panel x:Name="Overlay">

      <!-- Hover to look: what is under the mouse, at the foot of the map. -->
      <Border x:Name="HoverLabel" IsVisible="{Binding HoverText, Converter={x:Static ObjectConverters.IsNotNull}}"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" Padding="8,3"
              Background="#CC101218" BorderBrush="#556" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False">
        <TextBlock Text="{Binding HoverText}" Foreground="#ddd" FontSize="13" />
      </Border>

      <!-- Monster / object list ('[' and ']'), at the top right of the map as in Angband -->
      <Border IsVisible="{Binding IsShowingList}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
              MinWidth="360" MaxWidth="560" Background="#101218" BorderBrush="#556" BorderThickness="1" CornerRadius="6" Padding="14,10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding ListFooter}" Foreground="#888" FontSize="11" Margin="0,8,0,0" />
          <ScrollViewer MaxHeight="520">
            <ItemsControl x:Name="ListOverlay" ItemsSource="{Binding ListRows}" ItemTemplate="{StaticResource ListRowTemplate}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Store screen -->
      <Border IsVisible="{Binding IsInStore}" Margin="24" Background="#101218" BorderBrush="#556" BorderThickness="1"
              CornerRadius="6" Padding="18,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StoreTitle}" FontSize="20" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="{Binding StoreSubtitle}" Foreground="#e6c35c" TextWrapping="Wrap" />
            <TextBlock Text="{Binding StoreModeText}" Foreground="#8ab4f8" Margin="0,6,0,0" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Margin="0,10,0,0" Foreground="#888" FontSize="11" TextWrapping="Wrap"
                     Text="letter: one · Shift+letter: whole stack · Tab (pad X): buy/sell · arrows + Enter (pad A) · I: examine · Esc (pad B): leave" />
          <ListBox ItemsSource="{Binding StoreRows}" SelectedIndex="{Binding StoreSelectedIndex, Mode=OneWay}"
                   Focusable="False" IsHitTestVisible="False" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:StoreRow">
                <Grid ColumnDefinitions="Auto,18,*,Auto,70">
                  <TextBlock Grid.Column="0" MinWidth="22" Text="{Binding Letter, StringFormat={}{0})}" Foreground="#bbb"
                             FontFamily="{StaticResource MonoFont}" FontSize="13" />
                  <TextBlock Grid.Column="1" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                             FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" Foreground="#eee" TextWrapping="Wrap" />
                    <Border IsVisible="{Binding IsEquipped}" Background="#5a3a10" CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Equipped}" Foreground="#ffcc66" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding Price}" Foreground="#e6c35c" Margin="12,0" />
                  <TextBlock Grid.Column="4" Text="{Binding Weight}" Foreground="#888" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Inscription ('{'): the text to write on the chosen item -->
      <Border IsVisible="{Binding IsInscribing}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
              Background="#101218" BorderBrush="#556" BorderThickness="1" CornerRadius="6" Padding="14" MinWidth="460">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding InscriptionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBox x:Name="InscriptionBox" Text="{Binding InscriptionText}" MaxLength="80"
                   FontFamily="{StaticResource MonoFont}" />
          <TextBlock Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                     Text="Enter writes it, Escape cancels, empty removes it. @q1: press 1 in the quaff menu; !d: ask before dropping; =g / !g: always / never pick up; @f1: first in the quiver." />
        </StackPanel>
      </Border>

      <!-- Watching a replay: where it is, and the keys. -->
      <Border x:Name="ReplayBar" IsVisible="{Binding IsReplaying}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"
              Background="#E0201410" BorderBrush="#8a5a3b" BorderThickness="1" CornerRadius="6" Padding="12,6">
        <TextBlock Text="{Binding ReplayStatus}" Foreground="#f0dcc0" FontSize="13" />
      </Border>

      <!-- A hint for new players (each shown once; the option turns them off). -->
      <Border x:Name="HintBanner" IsVisible="{Binding HasHint}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,14"
              MaxWidth="720" Background="#E0142033" BorderBrush="#3b5b8a" BorderThickness="1" CornerRadius="6" Padding="12,8">
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="×" Command="{Binding DismissHintCommand}" Focusable="False" Padding="6,0"
                  Margin="10,0,0,0" VerticalAlignment="Top" Background="Transparent" Foreground="#9ab" ToolTip.Tip="Hide this hint" />
          <TextBlock TextWrapping="Wrap" Foreground="#dde6f5" FontSize="13">
            <Run Text="Tip: " FontWeight="SemiBold" Foreground="#8fc1ff" /><Run Text="{Binding HintText}" />
          </TextBlock>
        </DockPanel>
      </Border>

      <!-- Item prompt ("Quaff which potion?") -->
      <Border x:Name="PromptBox" IsVisible="{Binding IsPrompting}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"
              Background="#E0101018" BorderBrush="#556" BorderThickness="1" CornerRadius="6" Padding="14,10" MinWidth="420">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding PromptTitle}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxWidth="640" />
          <TextBlock Text="{Binding PromptText}" IsVisible="{Binding PromptText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Foreground="#dcd6c8" TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,4" />
          <ListBox x:Name="PromptList" ItemsSource="{Binding PromptRows}" IsVisible="{Binding !!PromptRows.Count}" ItemTemplate="{StaticResource ItemRowTemplate}"
                   SelectedIndex="{Binding PromptSelectedIndex, Mode=OneWay}" Focusable="False" Cursor="Hand"
                   Background="Transparent" Padding="0" />
          <ListBox x:Name="SpellPromptList" ItemsSource="{Binding SpellPromptRows}" IsVisible="{Binding !!SpellPromptRows.Count}" SelectedIndex="{Binding PromptSelectedIndex, Mode=OneWay}"
                   Focusable="False" Cursor="Hand" Background="Transparent" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SpellRow">
                <Grid ColumnDefinitions="Auto,200,Auto,Auto" Margin="0,1" ToolTip.Tip="{Binding Description}">
                  <TextBlock Grid.Column="0" MinWidth="22" Text="{Binding Letter, StringFormat={}{0})}" Foreground="#bbb"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#eee" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{Binding Stats}" Foreground="#9ab" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                  <TextBlock Grid.Column="3" Text="{Binding Note}" Foreground="#c96" FontSize="12" Margin="10,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ListBox x:Name="ChoiceList" ItemsSource="{Binding ChoiceRows}" IsVisible="{Binding !!ChoiceRows.Count}" SelectedIndex="{Binding PromptSelectedIndex, Mode=OneWay}"
                   Focusable="False" Cursor="Hand" Background="Transparent" Padding="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ChoiceRow">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock MinWidth="22" Text="{Binding Letter, StringFormat={}{0})}" Foreground="#bbb"
                             FontFamily="{StaticResource MonoFont}" FontSize="12" />
                  <TextBlock Text="{Binding Text}" Foreground="#eee" FontSize="12" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="Press a letter or click (or move and confirm), Esc to cancel." Foreground="#888" FontSize="11" />
        </StackPanel>
      </Border>
      </Panel>
      </LayoutTransformControl>
    </Panel>
  </DockPanel>

  <!-- A moment's scene at moments of note (the option "Show scenes at moments of note"). -->
  <controls:SceneView x:Name="SceneView" Scene="{Binding Scene}" IsVisible="{Binding HasScene}" />

  <!-- The title screen: Thangorodrim, the logo, and what to do. -->
  <Panel x:Name="TitleScreen" IsVisible="{Binding IsShowingTitle}" Background="#050305" ClipToBounds="True">
    <Image Source="{Binding TitleBackground}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Border IsHitTestVisible="False">
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,55%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#00000000" />
          <GradientStop Offset="1" Color="#D8000000" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="24,28,24,12">
      <Viewbox Grid.Row="0" MaxHeight="230" MaxWidth="820" Stretch="Uniform" HorizontalAlignment="Center">
        <Image Source="{Binding TitleLogo}" />
      </Viewbox>
      <ListBox Grid.Row="2" x:Name="TitleMenu" ItemsSource="{Binding TitleChoices}" SelectedIndex="{Binding TitleSelectedIndex}"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="32,0,0,0"
               Background="#B0100806" BorderBrush="#7a4a24" BorderThickness="1" CornerRadius="6"
               Padding="8,6" Focusable="False" Cursor="Hand" Tapped="OnTitleTapped" MinWidth="360">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="CornerRadius" Value="4" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6a3212" />
          </Style>
          <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#6a3212" />
          </Style>
          <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3a1c0c" />
          </Style>
          <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#7a3a16" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:TitleChoice">
            <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding Label}">
              <TextBlock Text="{Binding Letter, StringFormat={}{0})}" Foreground="#a07850" FontFamily="{StaticResource MonoFont}"
                         FontSize="14" MinWidth="28" VerticalAlignment="Center" />
              <StackPanel>
                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource TitleFont}" FontSize="20" Foreground="#f0d8a8" />
                <TextBlock Text="{Binding Detail}" IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}"
                           FontSize="12" Foreground="#b89878" Margin="1,0,0,2" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="14" Margin="0,10,8,0">
        <Button x:Name="UpdateNotice" Command="{Binding OpenUpdatePageCommand}" Cursor="Hand" Padding="8,2"
                IsVisible="{Binding UpdateNotice, Converter={x:Static ObjectConverters.IsNotNull}}"
                Background="#B0100806" BorderBrush="#c89a4a" BorderThickness="1" CornerRadius="4"
                ToolTip.Tip="Open the download page">
          <TextBlock Text="{Binding UpdateNotice}" Foreground="#f0d070" FontSize="12" TextWrapping="Wrap" MaxWidth="560" />
        </Button>
        <TextBlock Text="{Binding TitleFooter}" Foreground="#806850" FontSize="11" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Panel>
  </Panel>

</Window>
