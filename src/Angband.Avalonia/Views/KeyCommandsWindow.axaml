<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        x:Class="Angband.Avalonia.Views.KeyCommandsWindow"
        x:DataType="vm:KeyCommandsViewModel"
        Title="Keyboard commands"
        Width="860" Height="760"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock DockPanel.Dock="Left" Text="Find" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox x:Name="FilterBox" Text="{Binding Filter}" Watermark="a command, a key or a word (e.g. cast, wear, look)" />
    </DockPanel>
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="Keys follow your bindings in Settings → Controls. Esc or B closes." Opacity="0.6" VerticalAlignment="Center" />
      <Button x:Name="CloseButton" Grid.Column="1" Content="Close" Classes="accent" Click="OnClose" />
    </Grid>
    <Panel>
      <TextBlock Text="No command matches." IsVisible="{Binding NothingFound}" Opacity="0.6"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ScrollViewer Background="#111111">
        <ItemsControl x:Name="GroupList" ItemsSource="{Binding Groups}" Margin="12,6">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CommandGroup">
              <StackPanel Margin="0,8,0,4">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#8ab4f8" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CommandRow">
                      <Grid ColumnDefinitions="250,170,*,100" Margin="0,1">
                        <TextBlock Grid.Column="0" Text="{Binding Keys}" Foreground="#e6c35c" TextWrapping="Wrap"
                                   FontFamily="{StaticResource MonoFont}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding Command}" TextWrapping="Wrap" FontSize="13" />
                        <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap" FontSize="13" Opacity="0.85" />
                        <TextBlock Grid.Column="3" Text="{Binding Button}" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
