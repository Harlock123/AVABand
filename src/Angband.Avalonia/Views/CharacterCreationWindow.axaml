<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        xmlns:defs="using:Angband.Core.Definitions"
        x:Class="Angband.Avalonia.Views.CharacterCreationWindow"
        x:DataType="vm:CharacterCreationViewModel"
        Title="Create a character"
        Width="980" Height="700"
        WindowStartupLocation="CenterOwner">
  <!-- Name, then race, class and stats, then Start/Cancel: the order the controller's D-pad takes. -->
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
      <TextBlock Text="Name" VerticalAlignment="Center" FontWeight="SemiBold" />
      <TextBox x:Name="NameBox" Text="{Binding Name}" Width="240" />
      <Button Content="Random name" Command="{Binding RandomNameCommand}" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="200,12,200,12,*">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Race" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding RaceDescription}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,8,0,0" />
        <ListBox x:Name="RaceList" ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRace}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="defs:RaceDef"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Class" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ClassDescription}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" Margin="0,8,0,0" />
        <ListBox x:Name="ClassList" ItemsSource="{Binding Classes}" SelectedItem="{Binding SelectedClass}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="defs:ClassDef"><TextBlock Text="{Binding Name}" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <ScrollViewer Grid.Column="4">
      <StackPanel Spacing="8" Margin="0,0,14,0">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <ComboBox x:Name="MethodBox" ItemsSource="{Binding StatMethods}" SelectedItem="{Binding SelectedMethod}" MinWidth="170" />
          <Button Content="Reroll" Command="{Binding RerollCommand}" IsVisible="{Binding IsRolled}" VerticalAlignment="Center" />
          <Button x:Name="AutorollButton" Content="Autoroll" Command="{Binding AutorollCommand}" IsVisible="{Binding IsRolled}" VerticalAlignment="Center"
                  ToolTip.Tip="Reroll until every final stat reaches its minimum (the Min column)" />
        </StackPanel>
        <TextBlock Text="{Binding PointsText}" Opacity="0.8" TextWrapping="Wrap" />
        <TextBlock Text="{Binding AutorollText}" Foreground="#e6c35c" TextWrapping="Wrap"
                   IsVisible="{Binding AutorollText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Grid ColumnDefinitions="120,50,40,40,44,70,Auto" Margin="0,4,0,0">
          <TextBlock Grid.Column="1" Text="Base" Opacity="0.6" FontSize="12" />
          <TextBlock Grid.Column="2" Text="Race" Opacity="0.6" FontSize="12" />
          <TextBlock Grid.Column="3" Text="Class" Opacity="0.6" FontSize="12" />
          <TextBlock Grid.Column="5" Text="Final" Opacity="0.6" FontSize="12" />
          <TextBlock Grid.Column="6" Text="Min (autoroll)" Opacity="0.6" FontSize="12" IsVisible="{Binding IsRolled}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding StatRows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:StatRow">
              <Grid ColumnDefinitions="120,50,40,40,44,70,Auto,Auto,Auto" Margin="0,2">
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding BaseText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Grid.Column="2" Text="{Binding RaceMod}" VerticalAlignment="Center" Foreground="#8ab4f8" />
                <TextBlock Grid.Column="3" Text="{Binding ClassMod}" VerticalAlignment="Center" Foreground="#e6c35c" />
                <TextBlock Grid.Column="5" Text="{Binding Final}" VerticalAlignment="Center" FontWeight="Bold" />
                <Button Grid.Column="6" Content="−" Padding="10,0" Margin="2,0"
                        IsVisible="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).IsPointBuy}"
                        Command="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).DecreaseCommand}" CommandParameter="{Binding}" />
                <Button Grid.Column="7" Content="+" Padding="10,0" Margin="2,0"
                        IsVisible="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).IsPointBuy}"
                        Command="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).IncreaseCommand}" CommandParameter="{Binding}" />
                <ComboBox Grid.Column="8" MinWidth="96" Padding="6,2" FontSize="12"
                          ItemsSource="{x:Static vm:CharacterCreationViewModel.MinimumChoices}" SelectedIndex="{Binding MinimumIndex}"
                          IsVisible="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).IsRolled}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Background="#12151c" CornerRadius="6" Padding="12" Margin="0,10,0,0">
          <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="13" LineHeight="20" />
        </Border>
        <Expander x:Name="RaceComparisonPanel" Header="Compare races" HorizontalAlignment="Stretch">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="110,36,36,36,36,36,40,48" Margin="8,0,0,2">
              <TextBlock Text="Race" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="1" Text="STR" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="2" Text="INT" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="3" Text="WIS" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="4" Text="DEX" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="5" Text="CON" Opacity="0.6" FontSize="12" />
              <TextBlock Grid.Column="6" Text="HD" Opacity="0.6" FontSize="12" ToolTip.Tip="Hit die: hit points gained each level" />
              <TextBlock Grid.Column="7" Text="Exp" Opacity="0.6" FontSize="12" ToolTip.Tip="Experience needed, against a Human's 100%" />
            </Grid>
            <ItemsControl ItemsSource="{Binding RaceComparison}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RaceComparisonRow">
                  <Button Classes.chosen="{Binding IsSelected}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Padding="8,3" AutomationProperties.Name="{Binding Spoken}"
                          Command="{Binding $parent[Window].((vm:CharacterCreationViewModel)DataContext).ChooseRaceCommand}"
                          CommandParameter="{Binding Race}">
                    <StackPanel>
                      <Grid ColumnDefinitions="110,36,36,36,36,36,40,48">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Str}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="2" Text="{Binding Int}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="3" Text="{Binding Wis}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="4" Text="{Binding Dex}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="5" Text="{Binding Con}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="6" Text="{Binding HitDie}" FontFamily="{StaticResource MonoFont}" />
                        <TextBlock Grid.Column="7" Text="{Binding Experience}" FontFamily="{StaticResource MonoFont}" />
                      </Grid>
                      <TextBlock Text="{Binding Abilities}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              <ItemsControl.Styles>
                <Style Selector="Button">
                  <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="Button.chosen">
                  <Setter Property="Background" Value="#24324a" />
                </Style>
              </ItemsControl.Styles>
            </ItemsControl>
          </StackPanel>
        </Expander>
        <Expander x:Name="BirthOptions" Header="Birth options (fixed for the character's life)" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding BirthOptionRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OptionRow">
                <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Description}" Margin="0,1" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>
      </ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
      <TextBlock Text="{Binding Error}" Foreground="#ff8a80" VerticalAlignment="Center" />
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="StartButton" Content="Start the adventure" Classes="accent" Command="{Binding StartCommand}" />
    </StackPanel>
  </Grid>
</Window>
