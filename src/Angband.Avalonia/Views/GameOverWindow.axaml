<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        x:Class="Angband.Avalonia.Views.GameOverWindow"
        x:DataType="vm:GameOverMenuViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Opacity="0.85" Margin="0,1" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <!-- AVABand's own death recap: the last hurts, what went unused, and a tip. -->
    <Border x:Name="RecapPanel" IsVisible="{Binding HasRecap}" Background="#1a1512" BorderBrush="#4a3a2a" BorderThickness="1"
            CornerRadius="6" Padding="14,12">
      <StackPanel Spacing="8">
        <TextBlock Text="What happened" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Recap.Hurts}" IsVisible="{Binding Recap.HasHurts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Opacity="0.85" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding Recap.Unused}" IsVisible="{Binding Recap.HasUnused}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" Foreground="#e8a87c" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="RecapTip" Text="{Binding Recap.Tip}" TextWrapping="Wrap" Foreground="#e6c35c" />
      </StackPanel>
    </Border>
    <!-- AVABand's messages from the fallen: a last message for the headstone, found later where they fell. -->
    <Border x:Name="LastWordsPanel" IsVisible="{Binding HasLastWords}" Background="#15130f" BorderBrush="#4a4232" BorderThickness="1"
            CornerRadius="6" Padding="14,12">
      <StackPanel Spacing="8" DataContext="{Binding LastWords}" x:DataType="vm:LastWordsPrompt">
        <TextBlock Text="Leave a last message" FontWeight="SemiBold" />
        <TextBlock Text="A few words for your headstone. Those who come after may find them scratched into the floor where you fell."
                   TextWrapping="Wrap" FontSize="12" Opacity="0.75" />
        <StackPanel Spacing="8" IsVisible="{Binding !IsCarved}">
          <ComboBox x:Name="LastWordsPhrases" ItemsSource="{Binding Phrases}" SelectedItem="{Binding Phrase}"
                    PlaceholderText="Pick a ready-made phrase..." HorizontalAlignment="Stretch" />
          <DockPanel>
            <Button x:Name="LastWordsCarve" DockPanel.Dock="Right" Content="Carve it" Margin="8,0,0,0" Padding="12,6"
                    IsEnabled="{Binding CanCarve}" Click="OnCarve" />
            <TextBox x:Name="LastWordsBox" Text="{Binding Text}" MaxLength="{Binding MaxLength}"
                     PlaceholderText="...or write your own (80 letters at most)" />
          </DockPanel>
        </StackPanel>
        <TextBlock x:Name="LastWordsCarved" Text="{Binding Carved}" IsVisible="{Binding IsCarved}" TextWrapping="Wrap"
                   Foreground="#e6c35c" FontStyle="Italic" />
      </StackPanel>
    </Border>
    <ItemsControl x:Name="ChoiceList" ItemsSource="{Binding Choices}" Margin="0,4,0,0">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:GameOverChoice">
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3" Padding="12,8"
                  Click="OnChoice" Tag="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding Letter}" Foreground="#e6c35c" FontFamily="{StaticResource MonoFont}" />
              <TextBlock Text="{Binding Label}" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="A letter or a click chooses; Esc or B closes and leaves things as they are." Opacity="0.6" FontSize="12" />
  </StackPanel>
</Window>
