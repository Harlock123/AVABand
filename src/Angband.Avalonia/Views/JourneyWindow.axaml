<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        xmlns:controls="using:Angband.Avalonia.Controls"
        x:Class="Angband.Avalonia.Views.JourneyWindow"
        x:DataType="vm:JourneyViewModel"
        Title="{Binding Title}"
        Width="1040" Height="720"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="14">
    <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Opacity="0.75" Margin="0,2,0,10" />
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="Depth over time: red dots are uniques killed, violet ones artifacts found. Esc closes." Opacity="0.6" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="Close" Classes="accent" Click="OnClose" />
    </Grid>
    <controls:JourneyGraph x:Name="Graph" DockPanel.Dock="Top" Journey="{Binding}" Height="250" />
    <Grid ColumnDefinitions="*,12,*" Margin="0,10,0,0">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="150,60,90,60,70,*" Margin="8,0,0,4">
          <TextBlock Text="Depth" Foreground="#8fc1ff" />
          <TextBlock Grid.Column="1" Text="Visits" Foreground="#8fc1ff" />
          <TextBlock Grid.Column="2" Text="Turns" Foreground="#8fc1ff" />
          <TextBlock Grid.Column="3" Text="Kills" Foreground="#8fc1ff" />
          <TextBlock Grid.Column="4" Text="Uniques" Foreground="#8fc1ff" />
          <TextBlock Grid.Column="5" Text="Artifacts" Foreground="#8fc1ff" />
        </Grid>
        <ScrollViewer Background="#111111">
          <ItemsControl x:Name="DepthRows" ItemsSource="{Binding Rows}" Margin="8,4">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:JourneyRow">
                <Grid ColumnDefinitions="150,60,90,60,70,*" Margin="0,1">
                  <TextBlock Text="{Binding Depth}" />
                  <TextBlock Grid.Column="1" Text="{Binding Visits}" />
                  <TextBlock Grid.Column="2" Text="{Binding Time}" />
                  <TextBlock Grid.Column="3" Text="{Binding Kills}" />
                  <TextBlock Grid.Column="4" Text="{Binding Uniques}" Foreground="#e06060" />
                  <TextBlock Grid.Column="5" Text="{Binding Artifacts}" Foreground="#b070ff" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
      <ScrollViewer Grid.Column="2" Background="#111111">
        <SelectableTextBlock Text="{Binding History}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="10" />
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
