<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Angband.Avalonia.ViewModels"
        xmlns:v="using:Angband.Avalonia.Views"
        x:Class="Angband.Avalonia.Views.KnowledgeWindow"
        x:DataType="vm:KnowledgeViewModel"
        Title="Knowledge"
        Width="1160" Height="680"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Eleven tabs: a little smaller than the theme's, so they fit on one line. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <!-- Objects, runes, egos and artifacts: a list on the left, what is known on the right. -->
    <DataTemplate DataType="vm:KnowledgeCategoryViewModel">
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Opacity="0.7" Margin="0,8,0,0" />
        <Grid ColumnDefinitions="380,12,*">
          <Panel>
            <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}"
                       Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:KnowledgeRow">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="20"
                               FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Note}" Opacity="0.6" FontSize="12" Margin="8,0,0,0" />
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
          <DockPanel Grid.Column="2">
            <CheckBox DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding CanIgnore}" IsChecked="{Binding IsIgnored}"
                      Content="Ignore (hide these, and drop any you carry)" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding CanAutoInscribe}">
              <Button DockPanel.Dock="Right" Content="Set" Margin="8,0,0,0" Command="{Binding SetAutoInscriptionCommand}" />
              <TextBlock DockPanel.Dock="Left" Text="Auto-inscription" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8" />
              <TextBox x:Name="AutoInscriptionBox" Text="{Binding AutoInscription}" MaxLength="80" PlaceholderText="e.g. @q1 or =g"
                       FontFamily="{StaticResource MonoFont}" />
            </DockPanel>
            <ScrollViewer Background="#111111">
              <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="12" FontSize="14" />
            </ScrollViewer>
          </DockPanel>
        </Grid>
      </DockPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <DockPanel Margin="12">
    <Button DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0"
            Content="Close" Classes="accent" Click="OnClose" />
    <TabControl x:Name="Tabs" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="Monsters">
        <DockPanel DataContext="{Binding Monsters}" x:DataType="vm:MonsterKnowledgeViewModel">
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Opacity="0.7" Margin="0,8,0,0" />
          <Grid ColumnDefinitions="380,12,*">
            <Panel>
              <TextBlock Text="You have not met any monsters yet." IsVisible="{Binding IsEmpty}"
                         Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <ListBox x:Name="MonsterList" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MonsterKnowledgeRow">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Width="20"
                                 FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                      <TextBlock DockPanel.Dock="Right" Text="{Binding KillsText}" Opacity="0.6" FontSize="12" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
            <ScrollViewer Grid.Column="2" Background="#111111">
              <SelectableTextBlock Text="{Binding RecallText}" v:RichText.Runs="{Binding RecallRuns}" TextWrapping="Wrap" Margin="12" FontSize="14" />
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Objects" Content="{Binding Objects}" />
      <TabItem Header="Runes" Content="{Binding Runes}" />
      <TabItem Header="Egos" Content="{Binding Egos}" />
      <TabItem Header="Artifacts" Content="{Binding Artifacts}" />
      <TabItem Header="Features" Content="{Binding Features}" />
      <TabItem Header="Traps" Content="{Binding Traps}" />
      <TabItem Header="Shapes" Content="{Binding Shapes}" />
      <TabItem Header="Equipment">
        <DockPanel DataContext="{Binding Equipment}" x:DataType="vm:EquipComparisonViewModel">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
            <TextBlock Text="Slot" VerticalAlignment="Center" Opacity="0.8" />
            <ComboBox x:Name="EquipSlot" ItemsSource="{Binding Slots}" SelectedItem="{Binding Slot}" MinWidth="120" />
            <CheckBox Content="Include the shops' goods" IsChecked="{Binding IncludeShops}" />
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.7" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding Legend}" TextWrapping="Wrap" FontSize="11" Opacity="0.6" Margin="0,6,0,0" />
          <ScrollViewer DockPanel.Dock="Bottom" Height="150" Background="#111111" Margin="0,6,0,0">
            <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="10" FontSize="13" />
          </ScrollViewer>
          <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="{Binding Groups}" FontFamily="{StaticResource MonoFont}" FontSize="12" Opacity="0.6" />
              <TextBlock DockPanel.Dock="Top" Text="{Binding Headings}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="#8fc1ff" />
              <ListBox x:Name="EquipLines" ItemsSource="{Binding Lines}" SelectedItem="{Binding Selected}">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0,1" /><Setter Property="MinHeight" Value="0" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:EquipLine">
                    <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>
      <TabItem Header="Home" Content="{Binding Home}" />
      <TabItem Header="History">
        <ScrollViewer Background="#111111">
          <SelectableTextBlock Text="{Binding History}" FontFamily="{StaticResource MonoFont}" Margin="12" FontSize="14" />
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
