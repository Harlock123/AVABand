<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Saves written by earlier versions of AVABand, which must keep loading. -->
    <None Include="Saves\*.avasave" CopyToOutputDirectory="PreserveNewest" />
    <!-- And one with everything AVABand has added in use (RichSaveTests). -->
    <None Include="Saves\Rich\*.avasave" CopyToOutputDirectory="PreserveNewest" />
    <!-- Games the soak's bot played, each of which must still play back to the end it was recorded with. -->
    <None Include="Replays\*.avareplay" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Angband.Core\Angband.Core.csproj" />
    <ProjectReference Include="..\..\src\Angband.Data\Angband.Data.csproj" />
    <ProjectReference Include="..\..\src\Angband.Audio\Angband.Audio.csproj" />
    <ProjectReference Include="..\..\src\Angband.Input\Angband.Input.csproj" />
  </ItemGroup>
</Project>
